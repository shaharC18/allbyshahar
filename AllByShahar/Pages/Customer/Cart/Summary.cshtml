@page
@model AllByShahar.Pages.Customer.Cart.SummaryModel
@inject IOptions<AllByShahar.Utility.StripeSettings> Stripe
@using Microsoft.Extensions.Options
<form method="post" dir="rtl">
	<br />
	<div class="backgroundWhiteBorder">
		<div class="container">
			<div class="card">
				<div class="card-header bg-dark text-light ml-0 ">
					<div class="row">
						<div class="col-6 pt-2">
							<h3 class="text-white-50">סיכום הזמנה</h3>
						</div>
						<div class="col-6 text-start">
							<a asp-page="Index" class="btn btn-outline-info btn-sm ">בחזרה לעגלת הקניות</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="container rounded p-2">
						<div class="row">
							<div class="col-12 col-lg-6 pb-4">
								<div class="row">
									<h4 class="d-flex justify-content-between align-items-center mb-3">
										<span class="text-info">פרטי איסוף עצמי</span>
									</h4>
								</div>
								<div class="row my-1">
									<div class="col-3">
										<label>שם</label>
									</div>
									<div class="col-9">
										<input asp-for="OrderHeader.PickupName" class="form-control" />
										<span asp-validation-for="OrderHeader.PickupName" class="text-danger"></span>
									</div>
								</div>
								<div class="row my-1">
									<div class="col-3">
										<label>מספר טלפון</label>
									</div>
									<div class="col-9">
										<input asp-for="OrderHeader.PhoneNumber" class="form-control" />
										<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
									</div>
								</div>
								<div class="row my-1">
									<div class="col-3">
										<label>תאריך האיסוף</label>
									</div>
									<div class="col-9">
										<input value="" asp-for="OrderHeader.PickUpDate" type="date" class="form-control" />
										<span asp-validation-for="OrderHeader.PickUpDate" class="text-danger"></span>
									</div>
								</div>
								<div class="row my-1">
									<div class="col-3">
										<label>שעת האיסוף</label>
									</div>
									<div class="col-9">
										<input value="" asp-for="OrderHeader.PickUpTime" type="time" class="form-control" />
										<span asp-validation-for="OrderHeader.PickUpTime" class="text-danger"></span>
									</div>
								</div>
								<div class="row my-1">
									<div class="col-3">
										<label>הערות נוספות </label>
									</div>
									<div class="col-9">
										<textarea asp-for="OrderHeader.Comments" style="height:100px;" class="form-control"></textarea>
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-5 offset-lg-1">
								<h4 class="d-flex justify-content-between align-items-center mb-3">
									<span class="text-info">סיכום הזמנה</span>
								</h4>
								<ul class="list-group mb-3">
									@foreach (var detail in Model.ShoppingCartList)
									{
										<li class="list-group-item d-flex justify-content-between">
											<div>
												<h6 class="my-0">@detail.MenuItem.Name</h6>
												<small class="text-muted"> כמות :@detail.Count </small>
											</div>
											<span class="text-muted">₪@(Math.Round((detail.MenuItem.Price * @detail.Count),2))</span>
										</li>
									}
									<li class="list-group-item d-flex justify-content-between bg-light">
										<small class="text-info">סכום בש"ח</small>
										<strong class="text-info">₪@(Math.Round((Model.OrderHeader.OrderTotal), 2))</strong>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
				<div class="card-footer">
					<div class="row">
						<div class="col-12 col-md-4 offset-md-8">
							<button type="submit" id="btnPlaceOrder" value="Place Order" class="btn btn-success form-control">בצע הזמנה</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts{
	@{
		<script src="https://polyfill.io/v3/polyfill.min.js?version=3.52.1&features=fetch"></script>
		<script src="https://js.stripe.com/v3/"></script>
		<partial name="_ValidationScriptsPartial" />
	}
}